# ---- Publik (terlihat di browser, aman) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
NEXT_PUBLIC_SITE_URL=https://domain-kamu.com

# ---- RAHASIA (hanya server; JANGAN PERNAH diberi awalan NEXT_PUBLIC_) ----
# Supabase > Project Settings > API Keys > Secret key. Dipakai server untuk mencatat pembayaran.
SUPABASE_SECRET_KEY=
# Midtrans > Settings > Access Keys > Server Key (sandbox diawali "SB-")
MIDTRANS_SERVER_KEY=
# Isi "true" hanya setelah akun Midtrans produksi aktif dan Server Key produksi sudah dipasang
MIDTRANS_IS_PRODUCTION=false
